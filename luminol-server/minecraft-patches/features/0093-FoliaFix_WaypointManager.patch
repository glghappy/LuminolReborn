Subject: [PATCH] FoliaFix_WaypointManager


diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -692,7 +692,7 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
         this.sleepStatus = new SleepStatus();
         this.gameEventDispatcher = new GameEventDispatcher(this);
         //this.waypointManager = new ServerWaypointManager(this); // Paper - optimize ServerWaypointManager with locator bar disabled // Luminol - Restore waypoints
-        this.waypointManager = new me.earthme.luminol.utils.FoliaServerWaypointManager(this); // Luminol - Restore waypoints
+        this.waypointManager = new me.sucixr.kitin.fixes.foliafix.waypoint.KitinServerWaypointManager(this); // Kitin WaypointManager
         this.environmentAttributes = EnvironmentAttributeSystem.builder().addDefaultLayers(this).build();
         //this.updateSkyBrightness(); // Folia - region threading - delay until first tick
         // Paper start - rewrite chunk system
diff --git a/net/minecraft/server/level/ServerPlayer.java b/net/minecraft/server/level/ServerPlayer.java
--- a/net/minecraft/server/level/ServerPlayer.java
+++ b/net/minecraft/server/level/ServerPlayer.java
@@ -892,5 +892,8 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
     @Override
     public void tick() {
+        // Kitin start
+        this.kitin$drainQueuedTasks();
+        // Kitin end
         // Luminol start - Status bars
         this.statusBarList.tick();
         // Luminol end - Status bars
@@ -3717,5 +3720,35 @@ public class ServerPlayer extends Player implements ca.spottedleaf.moonrise.patc
     public org.bukkit.craftbukkit.entity.CraftPlayer getBukkitEntity() {
         return (org.bukkit.craftbukkit.entity.CraftPlayer) super.getBukkitEntity();
     }
-    // CraftBukkit end
+    // CraftBukkit
+
+    // Kitin start - player mailbox for region-safe callbacks
+    private final java.util.concurrent.ConcurrentLinkedQueue<Runnable> kitin$queuedTasks =
+            new java.util.concurrent.ConcurrentLinkedQueue<>();
+
+    public void kitin$scheduleToOrRun(final Runnable task) {
+        // 只要当前线程就是这个 player 的 tick thread，就直接跑
+        if (ca.spottedleaf.moonrise.common.util.TickThread.isTickThreadFor(this)) {
+            task.run();
+            return;
+        }
+        // 否则丢进邮箱，等 player 自己 tick 时处理
+        this.kitin$queuedTasks.add(task);
+    }
+
+    private void kitin$drainQueuedTasks() {
+        // 防止恶意/意外塞爆：每 tick 限量执行
+        for (int i = 0; i < 1024; i++) {
+            final Runnable r = this.kitin$queuedTasks.poll();
+            if (r == null) {
+                return;
+            }
+            try {
+                r.run();
+            } catch (Throwable t) {
+                com.mojang.logging.LogUtils.getLogger().error("[Kitin] queued task error", t);
+            }
+        }
+    }
+    // Kitin end
 }
